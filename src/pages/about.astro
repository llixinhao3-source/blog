---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechStackRadar from '../components/about/TechStackRadar.tsx';
import CareerTimeline from '../components/about/CareerTimeline.tsx';
import ExpandableProjectCards from '../components/about/ExpandableProjectCard.tsx';
import HardwareZone from '../components/about/HardwareZone.tsx';
import SocialLinks from '../components/about/SocialLinks.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="关于我"
  description="李心皓 — AI Agent 开发工程师 · 专注 OpenClaw 应用落地与全链路自动化"
>
  <main class="min-h-screen relative">
    <div class="mx-auto max-w-5xl px-4 sm:px-8 pb-20 pt-6">

      <header class="mb-8 sm:mb-12">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
          <div class="flex-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-text-primary mb-3 tracking-tight">李心皓</h1>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-text-secondary mb-4">
              <span class="flex items-center gap-1.5">24岁</span>
              <span class="text-text-muted">·</span>
              <span class="flex items-center gap-1.5">
                <span class="text-xs text-accent">📍</span> 本科 · 广东海洋大学寸金学院
              </span>
              <span class="text-text-muted">·</span>
              <span class="flex items-center gap-1.5">
                <span class="text-xs text-accent">🎓</span> 大数据专业
              </span>
            </div>
            <p class="text-text-secondary leading-relaxed max-w-2xl">
              AI Agent 开发工程师，专注于 <span class="text-accent">OpenClaw</span> 与 <span class="text-accent">Hermes</span> 双引擎框架落地。
              从 Python 全栈到多 Agent 编排，从数据可视化到全链路自动化——热衷用代码驱动业务效率的质变。
            </p>
            <p class="text-xs text-text-muted mt-3">
              工信部数据分析师 · 英语四级 · 驾驶证
            </p>
          </div>
          <div class="flex-shrink-0">
            <div
              class="w-20 h-20 rounded-2xl flex items-center justify-center"
              style="background: linear-gradient(135deg, rgba(192,132,252,0.15), rgba(232,121,249,0.1)); border: 1px solid rgba(192,132,252,0.2);"
            >
              <span class="text-3xl">🧑‍💻</span>
            </div>
          </div>
        </div>
        <SocialLinks />
      </header>

      <section class="mb-8 sm:mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-base">📊</span>
          <h2 class="hover-target text-sm font-semibold text-text-muted tracking-wider uppercase">技能雷达</h2>
        </div>
        <TechStackRadar client:visible />
      </section>

      <section class="mb-8 sm:mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-base">💡</span>
          <h2 class="hover-target text-sm font-semibold text-text-muted tracking-wider uppercase">项目经历</h2>
        </div>
        <ExpandableProjectCards client:visible />
      </section>

      <section class="mb-8 sm:mb-12">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-base">⚡</span>
          <h2 class="hover-target text-sm font-semibold text-text-muted tracking-wider uppercase">职业经历</h2>
        </div>
        <CareerTimeline client:visible />
      </section>

      <section class="mb-8 sm:mb-12">
        <HardwareZone client:visible baseUrl={baseUrl} />
      </section>

      <div class="text-center py-6 border-t border-white/5">
        <a href={`${baseUrl}/posts`} class="hover-target inline-flex items-center gap-2 text-sm text-accent hover:opacity-80 transition-colors">
          查看所有文章 →
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
