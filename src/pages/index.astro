---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import FullPageScroll from '../components/home/FullPageScroll.tsx';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import AboutSection from '../components/home/AboutSection.astro';
import ArticleCard from '../components/home/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const publishedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const searchPosts = publishedPosts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  category: post.data.category,
  date: post.data.date.toISOString(),
}));

// Stats
const totalPosts = publishedPosts.length;
const allTags = new Set<string>();
let totalWords = 0;
for (const post of publishedPosts) {
  post.data.tags.forEach(t => allTags.add(t));
  if (post.body) {
    totalWords += post.body.replace(/\s/g, '').length;
  }
}

import { NAV_ITEMS } from '../data/site';

const sections = NAV_ITEMS.map(item => ({
  id: item.href === '/' ? 'home' : item.href.replace('/', ''),
  label: item.label,
}));

const sectionBaseStyle = 'position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; transition: opacity 0.8s cubic-bezier(0.645, 0.045, 0.355, 1), transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1), filter 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);';
const sectionActiveStyle = sectionBaseStyle + ' opacity: 1; transform: scale(1) translateY(0); filter: blur(0px); pointer-events: auto; z-index: 10;';
const sectionInactiveStyle = sectionBaseStyle + ' opacity: 0; transform: scale(0.96) translateY(30px); filter: blur(8px); pointer-events: none; z-index: 0;';
---

<BaseLayout
  title="首页"
  description="专注 OpenClaw 应用落地与 AI Agent 全链路开发。记录智能体调教、Prompt 工程、工具链集成到企业级 AI 工作流部署的技术成长。"
>
  <div class="relative w-full h-screen overflow-hidden">
    <div id="section-home" style={sectionActiveStyle}>
      <HeroSection posts={searchPosts} />
    </div>

    <div id="section-posts" style={sectionInactiveStyle}>
      <div class="section-scroll h-full overflow-y-auto" style="scrollbar-width: thin; padding-top: 80px;">
        <div class="max-w-3xl w-full mx-auto px-[8%] pb-8">
          {/* Stats Cards */}
          <div class="grid grid-cols-3 gap-3 mb-8">
            <div class="glass-card !rounded-2xl text-center py-5 !scale-100 hover:!scale-[1.02] transition-transform">
              <div class="text-2xl sm:text-3xl font-bold text-accent mb-1">
                <span class="tabular-nums" style="font-family:'JetBrains Mono', monospace">{totalPosts}</span>
              </div>
              <div class="text-xs text-text-muted tracking-wide">篇文章</div>
            </div>
            <div class="glass-card !rounded-2xl text-center py-5 !scale-100 hover:!scale-[1.02] transition-transform">
              <div class="text-2xl sm:text-3xl font-bold text-accent-warm mb-1">
                <span class="tabular-nums" style="font-family:'JetBrains Mono', monospace">{allTags.size}</span>
              </div>
              <div class="text-xs text-text-muted tracking-wide">个标签</div>
            </div>
            <div class="glass-card !rounded-2xl text-center py-5 !scale-100 hover:!scale-[1.02] transition-transform">
              <div class="text-2xl sm:text-3xl font-bold text-text-primary mb-1">
                <span class="tabular-nums" style="font-family:'JetBrains Mono', monospace">{totalWords > 1000 ? Math.round(totalWords / 100) / 10 + 'k' : totalWords}</span>
              </div>
              <div class="text-xs text-text-muted tracking-wide">字总量</div>
            </div>
          </div>

          <div class="mb-6 flex items-center gap-3">
            <div class="w-1 h-8 rounded-full" style="background: linear-gradient(to bottom, #c084fc, #a78bfa);"></div>
            <div>
              <h2 class="text-2xl font-bold tracking-tight" style="font-family: 'JetBrains Mono', monospace;">
                技术沉淀
              </h2>
              <p class="text-sm text-text-muted">
                共 {publishedPosts.length} 篇 · 每一步都是脚印
              </p>
            </div>
          </div>

          <div class="relative pl-6" style="border-left: 1px solid rgba(192,132,252,0.15);">
            {publishedPosts.map((post, i) => (
              <div class="relative mb-8 last:mb-0">
                <div
                  class="absolute -left-6 top-5 w-3 h-3 rounded-full border-2"
                  style={{
                    borderColor: i === 0 ? '#c084fc' : 'rgba(192,132,252,0.3)',
                    background: i === 0 ? '#c084fc' : 'transparent',
                    boxShadow: i === 0 ? '0 0 8px rgba(192,132,252,0.4)' : 'none',
                    transform: 'translateX(-50%)',
                    left: '-0.5px',
                  }}
                />
                <ArticleCard post={post} />
              </div>
            ))}
          </div>

          <div class="mt-12 mb-8 flex flex-col items-center gap-2">
            <span class="text-xs tracking-widest uppercase" style="color: rgba(192,132,252,0.4); font-family: 'JetBrains Mono', monospace;">
              Next: My Projects
            </span>
            <button
              class="hover-target next-section-trigger flex flex-col items-center gap-1 cursor-pointer group"
              aria-label="下一页"
            >
              <svg class="breath-arrow-sm" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(192,132,252,0.5);">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div id="section-projects" style={sectionInactiveStyle}>
      <div class="section-scroll h-full overflow-y-auto" style="scrollbar-width: thin; padding-top: 80px;">
        <div class="max-w-3xl w-full mx-auto px-[8%] pb-8">
          <ProjectsSection />

          <div class="mt-12 mb-8 flex flex-col items-center gap-2">
            <span class="text-xs tracking-widest uppercase" style="color: rgba(192,132,252,0.4); font-family: 'JetBrains Mono', monospace;">
              Next: About Me
            </span>
            <button
              class="hover-target next-section-trigger flex flex-col items-center gap-1 cursor-pointer group"
              aria-label="下一页"
            >
              <svg class="breath-arrow-sm" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(192,132,252,0.5);">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div id="section-about" style={sectionInactiveStyle}>
      <div class="section-scroll h-full overflow-y-auto" style="scrollbar-width: thin; padding-top: 80px;">
        <AboutSection />
      </div>
    </div>

    <FullPageScroll client:load sections={sections} baseUrl={import.meta.env.BASE_URL} />
  </div>

  <style>
    .breath-arrow-sm {
      animation: breathBounceSm 2.5s ease-in-out infinite;
    }
    @keyframes breathBounceSm {
      0%, 100% { transform: translateY(0); opacity: 0.4; }
      50% { transform: translateY(6px); opacity: 0.8; }
    }
  </style>

  <script>
    document.querySelectorAll('.next-section-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('navigate-next'));
      });
    });
  </script>
</BaseLayout>
