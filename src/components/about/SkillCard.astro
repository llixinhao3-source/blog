---
interface Props {
  icon: string;
  title: string;
  skills: string[];
}

const { icon, title, skills } = Astro.props;
---

<div class="border border-border/30 rounded-lg p-5 hover:border-border transition-all hover:bg-bg-card/30">
  <div class="flex items-center gap-3 mb-4">
    <span class="text-xl">{icon}</span>
    <h3 class="text-sm font-medium text-text-primary">{title}</h3>
  </div>
  <div class="flex flex-wrap gap-1.5">
    {skills.map((skill) => (
      <span class="text-xs text-text-secondary bg-bg-card/50 px-2 py-0.5 rounded">
        {skill}
      </span>
    ))}
  </div>
</div>