---
import { NAV_ITEMS, SITE_CONFIG } from '../../data/site';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === baseUrl || currentPath === baseUrl + '/';
---

<header class="fixed top-3 left-1/2 -translate-x-1/2 z-50 transition-all duration-500 w-[calc(100%-2rem)] max-w-3xl" id="site-header">
  <div class="glass-card !rounded-2xl px-6 h-14 flex items-center justify-between" id="header-inner">
    <a href={baseUrl || '/'} class="hover-target text-base font-semibold tracking-tight text-text-primary hover:text-accent transition-colors" data-nav-section="home">
      {SITE_CONFIG.title}
    </a>

    <nav class="hidden md:flex items-center gap-6" id="main-nav">
      {NAV_ITEMS.map((item) => {
        const sectionId = item.href === '/' ? 'home' : item.href.replace('/', '');
        const isActive = isHome ? false : currentPath === item.href || currentPath.startsWith(item.href + '/');
        const fullHref = item.href === '/' && baseUrl ? baseUrl : baseUrl + item.href;
        
        // 关于始终跳转页面，首页/文章/项目在首页内切换
        const alwaysHref = item.label === '关于';
        
        return isHome && !alwaysHref ? (
          <button
            key={item.label}
            data-nav-section={sectionId}
            class="nav-link-section hover-target relative text-sm font-medium tracking-wide text-text-secondary hover:text-text-primary transition-colors py-1"
          >
            {item.label}
          </button>
        ) : (
          <a
            key={item.label}
            href={fullHref}
            class={`nav-link-section hover-target relative text-sm font-medium tracking-wide transition-colors py-1 ${isActive ? 'text-text-primary' : 'text-text-secondary hover:text-text-primary'}`}
          >
            {item.label}
            {isActive && <span class="nav-underline" style="position:absolute;bottom:-2px;left:0;right:0;height:2px;background:linear-gradient(90deg,#c084fc,#a78bfa);border-radius:1px;" />}
          </a>
        );
      })}
    </nav>

    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
    >
      <span class="block w-5 h-[1.5px] rounded-full bg-text-secondary transition-all duration-300" />
      <span class="block w-5 h-[1.5px] rounded-full bg-text-secondary transition-all duration-300" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden mt-2 glass-card !rounded-2xl px-4 py-3"
  >
    <nav class="flex flex-col gap-1">
      {NAV_ITEMS.map((item) => {
        const sectionId = item.href === '/' ? 'home' : item.href.replace('/', '');
        const isActive = !isHome && (currentPath === item.href || currentPath.startsWith(item.href + '/'));
        const fullHref = item.href === '/' && baseUrl ? baseUrl : baseUrl + item.href;
        
        const alwaysHref = item.label === '关于';
        
        return isHome && !alwaysHref ? (
          <button
            key={item.label}
            data-nav-section={sectionId}
            class="mobile-nav-link text-sm font-medium py-2.5 px-3 rounded-xl transition-all text-text-secondary hover:text-text-primary hover:bg-white/5"
          >
            {item.label}
          </button>
        ) : (
          <a
            key={item.label}
            href={fullHref}
            class={`mobile-nav-link text-sm font-medium py-2.5 px-3 rounded-xl transition-all ${isActive ? 'text-accent bg-accent/10' : 'text-text-secondary hover:text-text-primary hover:bg-white/5'}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

{isHome && (
  <script>
    const headerInner = document.getElementById('header-inner');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    function updateActiveNav(sectionId: string) {
      document.querySelectorAll('.nav-link-section').forEach((el) => {
        const btn = el as HTMLElement;
        if (btn.dataset.navSection === sectionId) {
          btn.classList.add('active');
          btn.style.color = 'var(--color-text-primary)';
          if (!btn.querySelector('.nav-underline')) {
            const underline = document.createElement('span');
            underline.className = 'nav-underline';
            underline.style.cssText = 'position:absolute;bottom:-2px;left:0;right:0;height:2px;background:linear-gradient(90deg,#c084fc,#a78bfa);border-radius:1px;transform:scaleX(1);transition:transform 0.4s cubic-bezier(0.23,1,0.32,1);';
            btn.appendChild(underline);
          }
        } else if (!btn.href) {
          btn.classList.remove('active');
          btn.style.color = '';
          const existing = btn.querySelector('.nav-underline');
          if (existing) existing.remove();
        }
      });

      document.querySelectorAll('.mobile-nav-link').forEach((el) => {
        const btn = el as HTMLElement;
        if (btn.dataset.navSection === sectionId) {
          btn.classList.add('text-accent', 'bg-accent/10');
          btn.classList.remove('text-text-secondary');
        } else if (!btn.href) {
          btn.classList.remove('text-accent', 'bg-accent/10');
          btn.classList.add('text-text-secondary');
        }
      });
    }

    document.querySelectorAll('[data-nav-section]').forEach((el) => {
      el.addEventListener('click', () => {
        const sectionId = (el as HTMLElement).dataset.navSection;
        if (sectionId) {
          window.dispatchEvent(new CustomEvent('navigate-section', { detail: sectionId }));
          updateActiveNav(sectionId);
          if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
            mobileMenu.classList.add('hidden');
            const spans = mobileBtn?.querySelectorAll('span');
            if (spans) { spans[0].style.transform = ''; spans[1].style.transform = ''; }
          }
        }
      });
    });

    window.addEventListener('section-changed', ((e: CustomEvent) => {
      updateActiveNav(e.detail.id);
    }) as EventListener);

    updateActiveNav('home');

    mobileBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      const spans = mobileBtn.querySelectorAll('span');
      if (!mobileMenu?.classList.contains('hidden')) {
        spans[0].style.transform = 'rotate(45deg) translateY(5px)';
        spans[1].style.transform = 'rotate(-45deg) translateY(-5px)';
      } else {
        spans[0].style.transform = '';
        spans[1].style.transform = '';
      }
    });
  </script>
)}
