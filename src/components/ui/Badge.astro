---
interface Props {
  text: string;
  variant?: 'default' | 'accent' | 'warm';
  class?: string;
}

const { text, variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default: 'border-white/10 text-text-secondary bg-white/5',
  accent: 'border-sky-400/30 text-sky-300 bg-sky-400/10',
  warm: 'border-amber-400/30 text-amber-300 bg-amber-400/10',
};
---

<span class={`inline-block px-2.5 py-0.5 text-xs rounded-full border transition-colors ${variants[variant]} ${className}`}>
  {text}
</span>