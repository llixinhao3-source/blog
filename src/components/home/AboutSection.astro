---
import TechStackRadar from '../about/TechStackRadar.tsx';
import TechStackCards from '../about/TechStackCards.tsx';
import HardwareLab from '../about/HardwareLab.tsx';
import HardwareZone from '../about/HardwareZone.tsx';
import TypewriterTitle from '../about/TypewriterTitle.tsx';
import SocialLinks from '../about/SocialLinks.astro';
import ExpandableProjectCards from '../about/ExpandableProjectCard.tsx';
import CareerTimeline from '../about/CareerTimeline.tsx';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="section-about" class="overflow-y-auto h-full">
  <div class="mx-auto max-w-5xl px-4 sm:px-8 pb-20 pt-4 sm:pt-8">

    <header class="mb-6 sm:mb-10">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 sm:gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2">
            <h2 class="text-xl sm:text-2xl font-bold text-text-primary tracking-tight">李心皓</h2>
            <span class="text-xs text-text-muted bg-white/5 px-2 py-0.5 rounded-lg">24岁</span>
          </div>
          <div class="flex items-center gap-2 mb-2 text-text-muted text-xs sm:text-sm">
            <TypewriterTitle client:load />
          </div>
          <p class="text-text-secondary text-sm leading-relaxed max-w-xl">
            AI Agent 开发工程师，专注 <span class="text-accent">OpenClaw</span> 与 <span class="text-accent">Hermes</span> 双引擎业务落地。
          </p>
        </div>
        <div class="flex-shrink-0">
          <div
            class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex items-center justify-center"
            style="background: linear-gradient(135deg, rgba(192,132,252,0.15), rgba(232,121,249,0.1)); border: 1px solid rgba(192,132,252,0.2);"
          >
            <span class="text-2xl sm:text-3xl">🧑‍💻</span>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <SocialLinks />
      </div>
    </header>

    <div class="mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-sm">⚡</span>
        <h3 class="hover-target text-xs font-semibold text-text-muted tracking-wider uppercase">业务系统技术栈</h3>
      </div>
      <HardwareLab client:visible />
    </div>

    <div class="mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-sm">🛠</span>
        <h3 class="hover-target text-xs font-semibold text-text-muted tracking-wider uppercase">技能矩阵</h3>
      </div>
      <TechStackCards client:visible />
    </div>

    <div class="mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-sm">📊</span>
        <h3 class="hover-target text-xs font-semibold text-text-muted tracking-wider uppercase">技能雷达</h3>
      </div>
      <TechStackRadar client:visible />
    </div>

    <div class="mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-sm">💡</span>
        <h3 class="hover-target text-xs font-semibold text-text-muted tracking-wider uppercase">项目经历</h3>
      </div>
      <ExpandableProjectCards client:visible />
    </div>

    <div class="mb-6 sm:mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-sm">⚡</span>
        <h3 class="hover-target text-xs font-semibold text-text-muted tracking-wider uppercase">职业经历</h3>
      </div>
      <CareerTimeline client:visible />
    </div>

    <div class="mb-6 sm:mb-8">
      <HardwareZone client:visible baseUrl={baseUrl} />
    </div>
  </div>
</div>
