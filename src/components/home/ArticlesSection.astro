---
import ArticleCard from './ArticleCard.astro';

interface PostItem {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  category: string;
  date: string;
}

const { posts } = Astro.props as { posts: PostItem[] };
---

<div class="h-screen flex items-center justify-center px-6 overflow-y-auto">
  <div class="max-w-3xl w-full py-20">
    <div class="mb-8">
      <h2 class="hover-target text-2xl font-bold tracking-tight mb-2" style="font-family: 'JetBrains Mono', monospace;">
        文章列表
      </h2>
      <p class="text-sm text-text-muted">
        共 {posts.length} 篇技术文章
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {posts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
  </div>
</div>
