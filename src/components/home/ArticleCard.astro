---
import { formatDate, getCategoryLabel } from '../../utils/date';
import Badge from '../ui/Badge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, date, category, tags } = post.data;
---

<a
  href={`/posts/${post.id}`}
  class="group glass-card !rounded-2xl p-5 block"
>
  <div class="flex items-center gap-3 mb-3">
    <span class="text-xs text-text-muted tabular-nums" style="font-family: 'JetBrains Mono', monospace;">
      {formatDate(date)}
    </span>
    <Badge text={getCategoryLabel(category)} />
  </div>

  <h3 class="text-base font-semibold text-text-primary group-hover:text-accent transition-colors mb-2 leading-snug">
    {title}
  </h3>

  <p class="text-sm text-text-secondary leading-relaxed line-clamp-2 mb-3">
    {description}
  </p>

  <div class="flex flex-wrap gap-1.5">
    {tags.slice(0, 4).map((tag) => (
      <span class="text-xs text-text-muted hover:text-accent transition-colors">
        #{tag}
      </span>
    ))}
  </div>
</a>