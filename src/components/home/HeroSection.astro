---
import ArmExplodedView from './ArmExplodedView.tsx';
import MusicPlayer from './MusicPlayer.tsx';
import PersonalIntro from './PersonalIntro.tsx';
import SearchBox from './SearchBox.tsx';
import MaskRevealHeading from './MaskRevealHeading.tsx';

interface PostItem {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  category: string;
  date: string;
}

const { posts } = Astro.props as { posts: PostItem[] };
---

<div class="relative overflow-hidden h-screen">
  <div class="absolute inset-0">
    <ArmExplodedView client:load />
  </div>

  <div class="relative z-10 h-full flex flex-col items-center justify-center px-4 sm:px-6">
    <div class="w-full max-w-[1200px] flex flex-col items-center gap-5 relative">

      <div class="hidden lg:flex items-start justify-between w-full absolute top-24 left-0 right-0 max-w-[1200px] mx-auto px-4">
        <div class="w-52 flex-shrink-0" style="perspective: 1000px;">
          <PersonalIntro client:load />
        </div>
        <div class="w-52 flex-shrink-0" style="perspective: 1000px;">
          <MusicPlayer client:load />
        </div>
      </div>

      <div class="w-full flex justify-center" style="margin-top: 2vh;">
        <div class="w-full max-w-lg">
          <SearchBox posts={posts} client:load />
        </div>
      </div>

      <div class="text-center px-6" style="margin-top: 3vh;">
        <MaskRevealHeading client:load />
        <p class="text-base sm:text-lg text-text-secondary/80 max-w-md mx-auto leading-relaxed mt-4"
           style="text-shadow: 0 0 25px rgba(15,23,42,0.6);">
          OpenClaw 应用工程师 &amp; AI Agent 开发工程师
        </p>
      </div>

      <div class="lg:hidden flex flex-col items-center gap-3 mt-4 w-full">
        <PersonalIntro client:load />
        <MusicPlayer client:load />
      </div>

    </div>
  </div>

  <button
    id="scroll-next-btn"
    class="hover-target absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-1 cursor-pointer group"
    aria-label="下一页"
  >
    <span class="text-xs text-text-muted/50 group-hover:text-text-secondary transition-colors">探索更多</span>
    <svg class="breath-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(192,132,252,0.5);">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </button>

  <style>
    .breath-arrow {
      animation: breathBounce 2.5s ease-in-out infinite;
    }
    @keyframes breathBounce {
      0%, 100% { transform: translateY(0); opacity: 0.5; }
      50% { transform: translateY(8px); opacity: 0.9; }
    }
  </style>
</div>

<script>
  document.getElementById('scroll-next-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('navigate-section', { detail: 'articles' }));
  });
</script>
