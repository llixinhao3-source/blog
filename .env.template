# ═══════════════════════════════════════════════════════
# Sevik Blog · MCP Server 环境变量模板
# 复制为 .env 后填入真实值
# ═══════════════════════════════════════════════════════

# --- GitHub 仓库信息 ---
GIT_REMOTE=origin
GIT_BRANCH=main

# --- GitHub Personal Access Token (用于 API 版脚本) ---
# 权限: repo (读写仓库内容)
# 创建地址: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- 博客域名 ---
CNAME_DOMAIN=sevik.me

# --- OpenClaw 配置 ---
# OPENCLAW_API_KEY=sk-xxxxxxxx  # 如果 OpenClaw 需要
